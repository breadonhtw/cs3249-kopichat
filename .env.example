# Which provider to use: anthropic or openai. Leave empty to use whichever key is set (Anthropic first).
LLM_PROVIDER=
# Anthropic API key (paste your own key here, in .env, never in backend/llm.py)
ANTHROPIC_API_KEY=
# OpenAI-compatible API key, for example your NUS SoCLaaS key
OPENAI_API_KEY=
# Model name. Leave empty for the provider's default; SoCLaaS users set default; real OpenAI users set their model name.
LLM_MODEL=
# Seconds to wait for an LLM reply before giving up
LLM_TIMEOUT=8

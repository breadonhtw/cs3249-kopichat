# Which provider to use: anthropic or openai (empty = whichever key is set)
LLM_PROVIDER=
# OpenAI-compatible API key (copy to .env and paste your own key there)
OPENAI_API_KEY=
# Base URL of the OpenAI-compatible endpoint (SoCLaaS)
OPENAI_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# Model name (empty = the provider's default model)
LLM_MODEL=
# Seconds to wait for an LLM reply before giving up
LLM_TIMEOUT=8
